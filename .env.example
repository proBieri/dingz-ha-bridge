# MQTT broker the dingz publish to
DINGZ_MQTT_HOST=192.168.1.10
DINGZ_MQTT_PORT=1883
DINGZ_MQTT_USERNAME=dingz-ha-bridge
DINGZ_MQTT_PASSWORD=change-me

# TLS (port then defaults to 8883). Own CA as PEM file, optionally a client certificate.
# DINGZ_MQTT_TLS=1
# DINGZ_MQTT_CA_FILE=/certs/mqtt-ca.pem
# DINGZ_MQTT_CLIENT_CERT=/certs/client.pem
# DINGZ_MQTT_CLIENT_KEY=/certs/client.key
# DINGZ_MQTT_TLS_INSECURE=1   # testing only: no certificate check

# Separate set of HA devices for testing next to an existing integration:
# DINGZ_ID_PREFIX=dingztest
# DINGZ_NAME_PREFIX=TEST

# Read names and output types from the dingz HTTP API (default on)
# Set DINGZ_LOG_LEVEL=DEBUG for more output.

# Optional web UI (device list, status, set MQTT broker on a dingz).
# Off localhost a password is mandatory (HTTP basic auth, any user name).
DINGZ_UI=1
DINGZ_UI_BIND=0.0.0.0
DINGZ_UI_PORT=8099
DINGZ_UI_PASSWORD=change-me-too
# Raw dingz temperature instead of the filtered one (see docs/features.md#temperature)
# DINGZ_TEMPERATURE_FILTER=0

# The UI asks GitHub (cached 6 h) whether a newer release exists; 0 disables it.
# DINGZ_UPDATE_CHECK=0
